<BoxContainer
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Orientation="Vertical">

    <GridContainer Columns="2" HorizontalExpand="True">
        <Label Name="MapName" StyleClasses="LabelSubtext" Text="{Loc 'round-info-station-time'}"/>
        <Label Name="MapNameValue" />
        <Label Name="RoundTimer" StyleClasses="LabelSubtext" Text="{Loc 'round-info-player-count'}"/>
        <Label Name="RoundTimerValue" />
        <Label Name="PlayerCount" StyleClasses="LabelSubtext" Text="{Loc 'round-info-map-name'}"/>
        <Label Name="PlayerCountValue" />
    </GridContainer>

</BoxContainer>
